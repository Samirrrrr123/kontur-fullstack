{
  "info": {
    "name": "Контур API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Выполните вход автора и создание статьи, затем вход читателя. Переменные заполнятся автоматически. Удаление проверяйте на созданной для теста публикации."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "readerToken",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Состояние API",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Регистрация нового пользователя",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Новый автор\",\n  \"email\": \"new.author@example.com\",\n  \"password\": \"Password2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Вход автора",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"samir@kontur.local\",\n  \"password\": \"Kontur2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Вход успешен\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Профиль автора",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "Публичная лента",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/posts"
      }
    },
    {
      "name": "Три публикации с наибольшим числом лайков",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/posts/popular"
      }
    },
    {
      "name": "Фильтр темы и вида",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/posts?topic=design&kind=article"
      }
    },
    {
      "name": "Мои статьи",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/posts/mine"
      }
    },
    {
      "name": "Создать статью",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/posts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Статья для проверки API\",\n  \"excerpt\": \"Демонстрационная публикация\",\n  \"content\": \"Это статья, созданная специально для проверки запросов API. После демонстрации её можно удалить.\",\n  \"topic\": \"design\",\n  \"kind\": \"article\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статья создана\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"postId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Получить статью",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/posts/{{postId}}"
      }
    },
    {
      "name": "Изменить статью",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/posts/{{postId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Изменённый заголовок\",\n  \"excerpt\": \"Демонстрационная публикация\",\n  \"content\": \"Это статья, созданная специально для проверки запросов API. После демонстрации её можно удалить.\",\n  \"topic\": \"design\",\n  \"kind\": \"article\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Вход читателя",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"artem@kontur.local\",\n  \"password\": \"Kontur2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Вход успешен\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"readerToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Чужую статью изменить нельзя — 403",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{readerToken}}"
          }
        ],
        "url": "{{baseUrl}}/posts/{{postId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Статья для проверки API\",\n  \"excerpt\": \"Демонстрационная публикация\",\n  \"content\": \"Это статья, созданная специально для проверки запросов API. После демонстрации её можно удалить.\",\n  \"topic\": \"design\",\n  \"kind\": \"article\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Изменение чужого запрещено\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Поставить лайк",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{readerToken}}"
          }
        ],
        "url": "{{baseUrl}}/posts/{{postId}}/like"
      }
    },
    {
      "name": "Убрать лайк",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{readerToken}}"
          }
        ],
        "url": "{{baseUrl}}/posts/{{postId}}/like"
      }
    },
    {
      "name": "Оставить комментарий",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{readerToken}}"
          }
        ],
        "url": "{{baseUrl}}/posts/{{postId}}/comments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Проверка комментариев из Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Комментарий создан\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"commentId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Список комментариев",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/posts/{{postId}}/comments"
      }
    },
    {
      "name": "Удалить свой комментарий",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{readerToken}}"
          }
        ],
        "url": "{{baseUrl}}/comments/{{commentId}}"
      }
    },
    {
      "name": "Без токена — 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/posts/mine"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Без входа доступ запрещён\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Удалить свою тестовую статью",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/posts/{{postId}}"
      }
    }
  ]
}
